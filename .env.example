# Copy to .env and fill in. Never commit .env.

# Shared secret the iOS Shortcut sends in the x-auth-token header.
# Generate one with: openssl rand -hex 32
WEBHOOK_TOKEN=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

PORT=3479
UPLOAD_DIR=/tmp/sitescribe-uploads
MAX_PHOTOS=5
LOG_LEVEL=info
TIME_ZONE=America/New_York
# Set to true only when running behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false

# Model overrides (optional)
# MODEL_FAST=claude-haiku-4-5
# MODEL_SMART=claude-sonnet-4-6
# MODEL_TRANSCRIBE=gpt-4o-mini-transcribe

# Mail delivery: "file" writes messages to MAIL_OUTBOX_DIR (local dev),
# "graph" sends through Microsoft Graph with an app registration (Mail.Send).
MAIL_TRANSPORT=file
MAIL_OUTBOX_DIR=/tmp/sitescribe-outbox

# Required when MAIL_TRANSPORT=graph
MAIL_FROM=
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
